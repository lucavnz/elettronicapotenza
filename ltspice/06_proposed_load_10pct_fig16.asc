TEXT 1856 976 Left 1 !.tran 0 1.4m 1.38m 2n\n.ic V(midA)={Vdc/2} V(midB)={Vdc/2} V(Vcf)=300 V(Vo)=300 V(gnd_sec)=0 I(Lf)=1.0\n.options plotwinsize=0 reltol=2e-3 trtol=7 gshunt=1e-10 cshunt=1p\n.meas tran T1 param 1u\n.meas tran T2 param 1u+3/fs\n.meas tran Vout_avg AVG V(Vo,gnd_sec) FROM T1 TO T2\n.meas tran Iout_avg AVG I(Lf) FROM T1 TO T2\n.meas tran Pout AVG V(Vo,gnd_sec)*I(Lf) FROM T1 TO T2\n.meas tran Pin AVG V(VBUS)*(-I(Vdc)) FROM T1 TO T2\n.meas tran Eff PARAM 100*Pout/Pin\n.meas tran Is_pk MAX I(Lseq) FROM T1 TO T2\n.meas tran Is_rms RMS I(Lseq) FROM T1 TO T2\n.meas tran Vd2_min MIN V(gnd_sec,sec_p) FROM T1 TO T2
